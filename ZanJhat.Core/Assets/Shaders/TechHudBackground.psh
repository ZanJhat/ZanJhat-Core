#ifdef GLSL

#ifdef GL_ES
precision highp float;
#endif

uniform vec2 u_renderSize;
uniform float u_time;

#define PI 3.14159265359

// Hàm tạo nhiễu ngẫu nhiên
float hash(float n) { return fract(sin(n) * 43758.5453123); }

// Hàm nhiễu 2D
float noise(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

// Hàm nhiễu Fractal (FBM) tạo vân nhám kim loại chân thực
float fbm(vec2 p) {
    float f = 0.0;
    float amp = 0.5;
    for(int i = 0; i < 4; i++) {
        f += noise(p) * amp;
        p *= 2.0;
        amp *= 0.5;
    }
    return f;
}

// Hàm tạo vân lục giác (Hex Grid) chìm
float hexGrid(vec2 p) {
    p *= 15.0; // Mật độ lục giác
    vec2 q = vec2(p.x * 1.1547, p.y + mod(floor(p.x * 1.1547), 2.0) * 0.5);
    vec2 f = fract(q) - 0.5;
    return smoothstep(0.4, 0.45, max(abs(f.x * 0.866 + f.y * 0.5), abs(f.y)));
}

// Hàm vẽ vòng đứt nét
float dashedRing(vec2 uv, float radius, float thickness, float dashCount, float speed, float dashRatio) {
    float d = length(uv);
    float ring = smoothstep(thickness, 0.0, abs(d - radius));
    float angle = atan(uv.y, uv.x);
    float dash = step(dashRatio, fract((angle + u_time * speed) * dashCount / (2.0 * PI)));
    return ring * dash;
}

void main()
{
    vec2 uv = (gl_FragCoord.xy - 0.5 * u_renderSize.xy) / u_renderSize.y;
    
    // --- 1. CHẤT LIỆU BẠC KIM LOẠI CHÂN THỰC (REALISTIC SILVER METAL) ---
    vec2 lightPos = vec2(sin(u_time * 0.3) * 0.8, cos(u_time * 0.2) * 0.5);
    float lightDist = length(uv - lightPos);
    
    // Vân kim loại (Vết ố nhám + phay xước siêu mịn)
    float smudges = fbm(uv * 5.0) * 0.15;
    float brushed = fbm(uv * vec2(300.0, 1.0)) * 0.08;
    
    // Lưới lục giác Carbon chìm dưới lớp bạc
    float hexPattern = hexGrid(uv) * 0.04;

    // Rãnh ghép mạch (Panels)
    float grooveX = smoothstep(0.002, 0.0, abs(fract(uv.x * 3.0) - 0.5));
    float grooveY = smoothstep(0.002, 0.0, abs(fract(uv.y * 5.0) - 0.5));
    float grooves = (grooveX + grooveY) * 0.2;

    // Phản xạ ánh sáng (Sharp Specular Highlight) kết hợp độ nhám
    float spec = pow(max(1.0 - lightDist * (1.0 + smudges), 0.0), 12.0); 
    
    vec3 metalDark = vec3(0.2, 0.22, 0.25);
    vec3 metalLight = vec3(0.7, 0.75, 0.8);
    vec3 bgColor = mix(metalDark, metalLight, spec) + brushed - grooves - hexPattern;

    // --- 2. ÁNH SÁNG HUD (CORE & RADAR) ---
    vec3 hudColor = vec3(0.0);
    vec3 colCyan = vec3(0.0, 0.8, 1.0);
    vec3 colBlue = vec3(0.0, 0.4, 0.9);

    float t = u_time * 0.5;
    float r = length(uv);
    float a = atan(uv.y, uv.x);

    // Lõi vi mạch trung tâm (Bloom cực mạnh)
    float chipBox = max(abs(uv.x), abs(uv.y));
    float chipGlow = smoothstep(0.1, 0.0, chipBox); // Bloom tỏa rộng
    float chipCore = smoothstep(0.025, 0.02, chipBox);
    hudColor += colCyan * chipGlow * (0.4 + 0.6 * sin(u_time * 10.0)); // Nhịp thở ánh sáng
    hudColor += vec3(0.8, 0.9, 1.0) * chipCore * 2.0; // Trắng lóa ở lõi

    // Vòng tròn cơ khí bao quanh lõi
    hudColor += colCyan * dashedRing(uv, 0.12, 0.002, 40.0, 1.5, 0.5);
    hudColor += colBlue * dashedRing(uv, 0.18, 0.006, 16.0, -1.0, 0.3) * 0.8;
    hudColor += colCyan * dashedRing(uv, 0.22, 0.0015, 90.0, 0.4, 0.6);

    // Vùng Radar cực sắc nét và nhỏ
    float scan = mod(a - u_time * 3.0, 2.0 * PI) / (2.0 * PI);
    float scanArea = smoothstep(0.05, 0.18, r) * smoothstep(0.20, 0.18, r);
    hudColor += colCyan * (1.0 - scan) * scanArea * 0.6;
    hudColor += vec3(0.9, 0.95, 1.0) * smoothstep(0.995, 1.0, 1.0 - scan) * scanArea * 2.0;

    // Blend: Cộng Additive ánh sáng lên nền kim loại
    vec3 finalColor = bgColor + hudColor;
    
    // Vignette làm tối khung hình
    finalColor *= exp(-1.2 * r);

    gl_FragColor = vec4(finalColor, 1.0);
}

#endif
