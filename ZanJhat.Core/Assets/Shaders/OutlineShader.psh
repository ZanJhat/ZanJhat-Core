#ifdef GLSL

#ifdef GL_ES
precision highp float; // Dùng highp để đồng bộ với các shader khác, tránh lỗi vỡ hình
#endif

// <Sampler Name='u_sampler' Texture='u_texture' />

uniform vec4 u_outlineColor;
uniform sampler2D u_texture;
uniform float u_useTexture;

// Đổi 'in' thành 'varying'
varying vec2 v_texcoord;

void main()
{
    if (u_useTexture > 0.5) 
    {
        // GLES 2.0 bắt buộc dùng texture2D thay vì texture
        vec4 texColor = texture2D(u_texture, v_texcoord);
        
        if (texColor.a < 0.1) 
        {
            discard;
        }
    }
    
    // GLES 2.0 bắt buộc gán trực tiếp vào gl_FragColor
    gl_FragColor = u_outlineColor;
}

#endif
